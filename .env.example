NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=rag
DB_PASSWORD=rag
DB_NAME=rag

CHUNK_SIZE=1200
CHUNK_OVERLAP=150

# Ollama local — endpoint compatível com OpenAI
EMBEDDINGS_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDINGS_MODEL=bge-m3
EMBEDDINGS_DIMENSION=1024
EMBEDDINGS_BATCH_SIZE=16
EMBEDDINGS_TIMEOUT_MS=60000
EMBEDDINGS_MAX_RETRIES=0

# Threshold calibrado para bge-m3 neste corpus; ajuste após observar os scores
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.5

# DeepSeek via SDK OpenAI — preencha LLM_API_KEY para habilitar /chat
LLM_API_KEY=replace-me
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=0
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TEMPERATURE=0.1
